VITE_USE_MOCK=false
VITE_CHAIN_ID=1337
VITE_RPC_URL=http://127.0.0.1:8545
# Sepolia frontend: VITE_CHAIN_ID=11155111 and leave VITE_RPC_URL empty to use the
# public fallback RPC, or set an origin-restricted one. VITE_* values are public.
# Sepolia deployer only (npm run deploy -- --network sepolia): never commit your .env file.
# SEPOLIA_RPC_URL=     # must NOT be domain-restricted; this runs from your machine
# DEPLOYER_KEY=
# ETHERSCAN_API_KEY=   # npm run verify:etherscan uploads source; verify:deployment checks it
